NODE_ENV=development
PORT=5001
APP_NAME=Dev-ment
API_VERSION=v1
TIMEZONE=Asia/Dhaka
APP_BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# JWT
JWT_ACCESS_SECRET=demo_access_secret_replace_with_random_32_plus_chars
JWT_REFRESH_SECRET=demo_refresh_secret_replace_with_random_32_plus_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Redis
# Local Redis; hosted providers commonly use rediss://default:password@host:6379
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=devment:
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000

# OTP
OTP_EXPIRES_IN_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM_NAME=Dev-ment
EMAIL_FROM_ADDRESS=your_email@gmail.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_ROOT_FOLDER=dev-ment

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CURRENCY=usd

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Cron
CRON_ENABLED=true
CRON_TIMEZONE=Asia/Dhaka
APP_BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000

# Seed Admin
SEED_ADMIN_NAME=Dev-ment Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your_admin_seed_password

# Seed Candidate
SEED_CANDIDATE_NAME=Demo Candidate
SEED_CANDIDATE_EMAIL=candidate@example.com
SEED_CANDIDATE_PASSWORD=your_candidate_seed_password
SEED_CANDIDATE_HEADLINE=Full Stack Developer
SEED_CANDIDATE_GITHUB_URL=https://github.com/example
SEED_CANDIDATE_LINKEDIN_URL=https://linkedin.com/in/example
SEED_CANDIDATE_PORTFOLIO_URL=https://example.com

# Seed Recruiter
SEED_RECRUITER_NAME=Demo Recruiter
SEED_RECRUITER_EMAIL=recruiter@example.com
SEED_RECRUITER_PASSWORD=your_recruiter_seed_password
SEED_RECRUITER_JOB_TITLE=Technical Recruiter
SEED_RECRUITER_COMPANY_NAME=Example Technologies
SEED_RECRUITER_COMPANY_DOMAIN=example.com
SEED_RECRUITER_COMPANY_WEBSITE=https://example.com
SEED_RECRUITER_FREE_CREDITS=2

# Logging
LOG_LEVEL=debug
