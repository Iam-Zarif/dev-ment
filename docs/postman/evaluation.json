{
  "info": {
    "_postman_id": "devment-clean-evaluation",
    "name": "Dev-ment - Evaluation APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{recruiterToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001/api/v1" },
    { "key": "recruiterToken", "value": "" },
    { "key": "candidateToken", "value": "" },
    { "key": "attemptId", "value": "" },
    { "key": "assessmentQuestionId", "value": "" }
  ],
  "item": [
    {
      "name": "Get Evaluations",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/evaluations?page=1&limit=20"
      }
    },
    {
      "name": "Get Evaluation",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/evaluations/{{attemptId}}"
      }
    },
    {
      "name": "Review Answer",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"manualScore\": 5,\n  \"recruiterFeedback\": \"Good answer.\"\n}"
        },
        "url": "{{baseUrl}}/evaluations/{{attemptId}}/questions/{{assessmentQuestionId}}"
      }
    },
    {
      "name": "Evaluate Attempt",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/evaluations/{{attemptId}}/evaluate"
      }
    },
    {
      "name": "Finalize Evaluation",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"finalFeedback\": \"Thank you for completing the assessment.\"\n}"
        },
        "url": "{{baseUrl}}/evaluations/{{attemptId}}/finalize"
      }
    },
    {
      "name": "Release Result",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/evaluations/{{attemptId}}/release"
      }
    },
    {
      "name": "Get Candidate Result",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{candidateToken}}", "type": "string" }]
        },
        "url": "{{baseUrl}}/evaluations/results/me/{{attemptId}}"
      }
    }
  ]
}