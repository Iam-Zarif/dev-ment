{
  "info": {
    "_postman_id": "devment-profile-final",
    "name": "Dev-ment - Profile APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api/v1"
    },
    {
      "key": "candidateToken",
      "value": ""
    },
    {
      "key": "recruiterToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Update Candidate Profile",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"legalName\": \"Demo Candidate\",\n  \"headline\": \"Backend Developer\",\n  \"bio\": \"Backend focused developer\",\n  \"experienceYears\": 2.5,\n  \"skills\": [\"TypeScript\", \"Node.js\", \"PostgreSQL\"],\n  \"githubUrl\": \"https://github.com/example\"\n}"
        },
        "url": "{{baseUrl}}/profiles/candidate"
      }
    },
    {
      "name": "Update Recruiter Profile",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{recruiterToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"legalName\": \"Demo Recruiter\",\n  \"jobTitle\": \"Technical Recruiter\",\n  \"phone\": \"+8801700000000\",\n  \"companyWebsiteUrl\": \"https://example.com\"\n}"
        },
        "url": "{{baseUrl}}/profiles/recruiter"
      }
    },
    {
      "name": "Create Upload Signature",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assetType\": \"PROFILE_IMAGE\"\n}"
        },
        "url": "{{baseUrl}}/profiles/upload-signature"
      }
    }
  ]
}