{
  "info": {
    "_postman_id": "78b229f0-devment-profile-final",
    "name": "Dev-ment - Profile & Cloudinary APIs",
    "description": "Candidate and recruiter profile updates plus signed direct Cloudinary upload signatures.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api/v1"
    },
    {
      "key": "candidateToken",
      "value": ""
    },
    {
      "key": "recruiterToken",
      "value": ""
    },
    {
      "key": "candidateProfileImageUrl",
      "value": ""
    },
    {
      "key": "candidateResumeUrl",
      "value": ""
    },
    {
      "key": "recruiterProfileImageUrl",
      "value": ""
    },
    {
      "key": "companyLogoUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Candidate Update Profile",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"legalName\": \"Demo Candidate\",\n  \"headline\": \"Backend Developer\",\n  \"bio\": \"Candidate profile updated from Postman.\",\n  \"experienceYears\": 2.5,\n  \"skills\": [\"TypeScript\", \"Node.js\", \"PostgreSQL\"],\n  \"githubUrl\": \"https://github.com/example\"\n}"
        },
        "url": "{{baseUrl}}/profiles/candidate"
      }
    },
    {
      "name": "02 - Candidate Profile Image Signature",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assetType\": \"PROFILE_IMAGE\"\n}"
        },
        "url": "{{baseUrl}}/profiles/upload-signature"
      }
    },
    {
      "name": "03 - Candidate Resume Signature",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assetType\": \"CANDIDATE_RESUME\"\n}"
        },
        "url": "{{baseUrl}}/profiles/upload-signature"
      }
    },
    {
      "name": "04 - Recruiter Update Profile",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{recruiterToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"legalName\": \"Demo Recruiter\",\n  \"jobTitle\": \"Technical Recruiter\",\n  \"phone\": \"+8801700000000\",\n  \"companyWebsiteUrl\": \"https://example.com\"\n}"
        },
        "url": "{{baseUrl}}/profiles/recruiter"
      }
    },
    {
      "name": "05 - Recruiter Profile Image Signature",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{recruiterToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assetType\": \"PROFILE_IMAGE\"\n}"
        },
        "url": "{{baseUrl}}/profiles/upload-signature"
      }
    },
    {
      "name": "06 - Company Logo Signature",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{recruiterToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assetType\": \"COMPANY_LOGO\"\n}"
        },
        "url": "{{baseUrl}}/profiles/upload-signature"
      }
    },
    {
      "name": "Optional Cloudinary URL Save",
      "item": [
        {
          "name": "Save Candidate Profile Image URL",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{candidateToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageUrl\": \"{{candidateProfileImageUrl}}\"\n}"
            },
            "url": "{{baseUrl}}/profiles/candidate"
          }
        },
        {
          "name": "Save Candidate Resume URL",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{candidateToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resumeUrl\": \"{{candidateResumeUrl}}\"\n}"
            },
            "url": "{{baseUrl}}/profiles/candidate"
          }
        },
        {
          "name": "Save Recruiter Profile Image URL",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageUrl\": \"{{recruiterProfileImageUrl}}\"\n}"
            },
            "url": "{{baseUrl}}/profiles/recruiter"
          }
        },
        {
          "name": "Save Company Logo URL",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyLogoUrl\": \"{{companyLogoUrl}}\"\n}"
            },
            "url": "{{baseUrl}}/profiles/recruiter"
          }
        }
      ]
    },
    {
      "name": "Negative Tests",
      "item": [
        {
          "name": "Candidate Cannot Update Recruiter Profile",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{candidateToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobTitle\": \"Invalid\"\n}"
            },
            "url": "{{baseUrl}}/profiles/recruiter"
          }
        },
        {
          "name": "Recruiter Cannot Upload Candidate Resume",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetType\": \"CANDIDATE_RESUME\"\n}"
            },
            "url": "{{baseUrl}}/profiles/upload-signature"
          }
        },
        {
          "name": "Candidate Cannot Upload Company Logo",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{candidateToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetType\": \"COMPANY_LOGO\"\n}"
            },
            "url": "{{baseUrl}}/profiles/upload-signature"
          }
        },
        {
          "name": "Empty Candidate Update Should Fail",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{candidateToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/profiles/candidate"
          }
        }
      ]
    }
  ]
}