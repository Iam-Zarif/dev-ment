				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Junior Backend Developer Assessment\",\n  \"jobRole\": \"Junior Backend Developer\",\n  \"descriptionHtml\": \"<p>Backend developer hiring assessment.</p>\",\n  \"instructionsHtml\": \"<p>Complete all questions within the given time.</p>\",\n  \"skills\": [\n    \"Node.js\",\n    \"TypeScript\",\n    \"PostgreSQL\"\n  ],\n  \"difficulty\": \"INTERMEDIATE\",\n  \"durationMinutes\": 60,\n  \"passPercentage\": 60,\n  \"suspiciousThreshold\": 3,\n  \"applicationDeadline\": \"2026-09-10T17:59:59.000Z\",\n  \"opensAt\": \"2026-09-08T04:00:00.000Z\",\n  \"closesAt\": \"2026-09-12T17:59:59.000Z\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/assessments",
					"host": ["{{baseUrl}}"],
					"path": ["assessments"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 201\", function () {",
							"  pm.response.to.have.status(201);",
							"});",
							"",
							"const json = pm.response.json();",
							"",
							"pm.test(\"Assessment created as DRAFT\", function () {",
							"  pm.expect(json.success).to.eql(true);",
							"  pm.expect(json.data.id).to.be.a(\"string\");",
							"  pm.expect(json.data.status).to.eql(\"DRAFT\");",
							"});",
							"",
							"if (json.success && json.data?.id) {",
							"  pm.collectionVariables.set(\"assessmentId\", json.data.id);",
							"}"
						]
					}
				}
			]
		},
