{
  "info": {
    "_postman_id": "devment-clean-invitation",
    "name": "Dev-ment - Invitation APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Recruiter-managed invitations, candidate email-token verification, and candidate authenticated in-app acceptance by invitation ID."
  },
  "item": [
    {
      "name": "Send Invitation",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{recruiterToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applicationIds\": [\"{{applicationId}}\"]\n}"
        },
        "url": "{{baseUrl}}/invitations"
      }
    },
    {
      "name": "Get Invitations",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{recruiterToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/invitations?page=1&limit=20"
      }
    },
    {
      "name": "Verify Invitation",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{invitationToken}}\"\n}"
        },
        "url": "{{baseUrl}}/invitations/verify"
      }
    },
    {
      "name": "Accept Invitation",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{invitationToken}}\"\n}"
        },
        "url": "{{baseUrl}}/invitations/accept"
      }
    },
    {
      "name": "Resend Invitation",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{recruiterToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/invitations/{{invitationId}}/resend"
      }
    },
    {
      "name": "Revoke Invitation",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{recruiterToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/invitations/{{invitationId}}/revoke"
      }
    },
    {
      "name": "Accept Invitation by ID",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/invitations/{{invitationId}}/accept",
        "description": "Candidate only. Authenticated in-app invitation acceptance by owned invitation UUID; no email token request body. Requires PENDING and unexpired invitation, INVITED application and published assessment.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    }
  ]
}
