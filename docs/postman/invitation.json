{
	"info": {
		"_postman_id": "970d6aef-967b-4057-8c39-82a714eb1a0c",
		"name": "Dev-ment - Invitation Queue APIs",
		"description": "Bulk shortlisted-candidate invitation queue, delivery status, candidate verify/accept, resend and revoke.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5001/api/v1"
		},
		{
			"key": "recruiterToken",
			"value": ""
		},
		{
			"key": "candidateToken",
			"value": ""
		},
		{
			"key": "assessmentId",
			"value": ""
		},
		{
			"key": "applicationId",
			"value": ""
		},
		{
			"key": "secondApplicationId",
			"value": ""
		},
		{
			"key": "invitationId",
			"value": ""
		},
		{
			"key": "secondInvitationId",
			"value": ""
		},
		{
			"key": "invitationToken",
			"value": ""
		}
	],
	"item": [
		{
			"name": "01 - Bulk Queue Invitations",
			"request": {
				"method": "POST",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{recruiterToken}}",
							"type": "string"
						}
					]
				},
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"assessmentId\": \"{{assessmentId}}\",\n  \"applicationIds\": [\n    \"{{applicationId}}\",\n    \"{{secondApplicationId}}\"\n  ]\n}"
				},
				"url": "{{baseUrl}}/invitations/bulk"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 202\", function () {",
							"  pm.response.to.have.status(202);",
							"});",
							"",
							"const json = pm.response.json();",
							"",
							"pm.test(\"Invitations queued\", function () {",
							"  pm.expect(json.success).to.eql(true);",
							"  pm.expect(json.data.queued).to.be.above(0);",
							"  pm.expect(json.data.invitations).to.be.an(\"array\");",
							"});",
							"",
							"if (json.data?.invitations?.[0]?.id) {",
							"  pm.collectionVariables.set(\"invitationId\", json.data.invitations[0].id);",
							"}",
							"",
							"if (json.data?.invitations?.[1]?.id) {",
							"  pm.collectionVariables.set(\"secondInvitationId\", json.data.invitations[1].id);",
							"}"
						]
					}
				}
			]
		},
		{
			"name": "02 - Get Invitation Queue Status",
			"request": {
				"method": "GET",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{recruiterToken}}",
							"type": "string"
						}
					]
				},
				"url": "{{baseUrl}}/invitations?assessmentId={{assessmentId}}&page=1&limit=20"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 200\", function () {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"const json = pm.response.json();",
							"",
							"pm.test(\"Delivery status is exposed\", function () {",
							"  pm.expect(json.success).to.eql(true);",
							"  pm.expect(json.data.items).to.be.an(\"array\");",
							"  if (json.data.items.length) {",
							"    pm.expect(json.data.items[0].emailDelivery.status).to.be.oneOf([\"PENDING\", \"SENT\", \"FAILED\"]);",
							"  }",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "03 - Filter Pending Invitations",
			"request": {
				"method": "GET",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{recruiterToken}}",
							"type": "string"
						}
					]
				},
				"url": "{{baseUrl}}/invitations?assessmentId={{assessmentId}}&deliveryStatus=PENDING&page=1&limit=20"
			}
		},
		{
			"name": "04 - Filter Sent Invitations",
			"request": {
				"method": "GET",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{recruiterToken}}",
							"type": "string"
						}
					]
				},
				"url": "{{baseUrl}}/invitations?assessmentId={{assessmentId}}&deliveryStatus=SENT&page=1&limit=20"
			}
		},
		{
			"name": "05 - Filter Failed Invitations",
			"request": {
				"method": "GET",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{recruiterToken}}",
							"type": "string"
						}
					]
				},
				"url": "{{baseUrl}}/invitations?assessmentId={{assessmentId}}&deliveryStatus=FAILED&page=1&limit=20"
			}
		},
		{
			"name": "06 - Candidate Verify Invitation",
			"request": {
				"method": "POST",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{candidateToken}}",
							"type": "string"
						}
					]
				},
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"token\": \"{{invitationToken}}\"\n}"
				},
				"url": "{{baseUrl}}/invitations/verify"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 200\", function () {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"const json = pm.response.json();",
							"",
							"pm.test(\"Invitation belongs to candidate\", function () {",
							"  pm.expect(json.success).to.eql(true);",
							"  pm.expect(json.data.applicationId).to.be.a(\"string\");",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "07 - Candidate Accept Invitation",
			"request": {
				"method": "POST",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{candidateToken}}",
							"type": "string"
						}
					]
				},
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"token\": \"{{invitationToken}}\"\n}"
				},
				"url": "{{baseUrl}}/invitations/accept"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 200\", function () {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"const json = pm.response.json();",
							"",
							"pm.test(\"Invitation accepted\", function () {",
							"  pm.expect(json.data.status).to.eql(\"ACCEPTED\");",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "08 - Accept Same Invitation Again",
			"request": {
				"method": "POST",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{candidateToken}}",
							"type": "string"
						}
					]
				},
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"token\": \"{{invitationToken}}\"\n}"
				},
				"url": "{{baseUrl}}/invitations/accept"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Second accept is rejected\", function () {",
							"  pm.response.to.have.status(409);",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "09 - Resend Second Invitation",
			"request": {
				"method": "POST",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{recruiterToken}}",
							"type": "string"
						}
					]
				},
				"url": "{{baseUrl}}/invitations/{{secondInvitationId}}/resend"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Resend is queued\", function () {",
							"  pm.response.to.have.status(202);",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "10 - Revoke Second Invitation",
			"request": {
				"method": "POST",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{recruiterToken}}",
							"type": "string"
						}
					]
				},
				"url": "{{baseUrl}}/invitations/{{secondInvitationId}}/revoke"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Invitation revoked\", function () {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"const json = pm.response.json();",
							"",
							"pm.test(\"Status is REVOKED\", function () {",
							"  pm.expect(json.data.status).to.eql(\"REVOKED\");",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "11 - Already Invited Application Should Fail",
			"request": {
				"method": "POST",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{recruiterToken}}",
							"type": "string"
						}
					]
				},
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"assessmentId\": \"{{assessmentId}}\",\n  \"applicationIds\": [\n    \"{{applicationId}}\"\n  ]\n}"
				},
				"url": "{{baseUrl}}/invitations/bulk"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Already invited application is rejected\", function () {",
							"  pm.response.to.have.status(409);",
							"});"
						]
					}
				}
			]
		}
	]
}
