		{
			"name": "01 - Create MCQ Question",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"type\": \"MCQ\",\n  \"contentHtml\": \"<p>Which one is a JavaScript library?</p>\",\n  \"difficulty\": \"BEGINNER\",\n  \"defaultMarks\": 5,\n  \"selectionMode\": \"SINGLE\",\n  \"options\": [\n    {\n      \"optionHtml\": \"React\",\n      \"isCorrect\": true,\n      \"sortOrder\": 1\n    },\n    {\n      \"optionHtml\": \"PostgreSQL\",\n      \"isCorrect\": false,\n      \"sortOrder\": 2\n    },\n    {\n      \"optionHtml\": \"Redis\",\n      \"isCorrect\": false,\n      \"sortOrder\": 3\n    }\n  ]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/questions",
					"host": ["{{baseUrl}}"],
					"path": ["questions"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 201\", function () {",
							"  pm.response.to.have.status(201);",
							"});",
							"",
							"const json = pm.response.json();",
							"",
							"pm.test(\"Question created successfully\", function () {",
							"  pm.expect(json.success).to.eql(true);",
							"  pm.expect(json.data.id).to.be.a(\"string\");",
							"});",
							"",
							"if (json.success && json.data?.id) {",
							"  pm.collectionVariables.set(\"questionId\", json.data.id);",
							"}"
						]
					}
				}
			]
		},
