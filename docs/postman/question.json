{
  "info": {
    "_postman_id": "devment-clean-question",
    "name": "Dev-ment - Question APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Recruiter-only question bank. Create request shape depends on type: MCQ, SHORT_TEXT, LONG_TEXT, or CODING."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{recruiterToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Create Question",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"MCQ\",\n  \"contentHtml\": \"<p>Which one is a JavaScript library?</p>\",\n  \"difficulty\": \"BEGINNER\",\n  \"defaultMarks\": 5,\n  \"selectionMode\": \"SINGLE\",\n  \"options\": [\n    {\n      \"optionHtml\": \"React\",\n      \"isCorrect\": true,\n      \"sortOrder\": 1\n    },\n    {\n      \"optionHtml\": \"PostgreSQL\",\n      \"isCorrect\": false,\n      \"sortOrder\": 2\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/questions",
        "description": "MCQ example. Exactly one option must be correct when selectionMode is SINGLE. For MULTIPLE, at least one option must be correct."
      }
    },
    {
      "name": "Get Questions",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/questions?page=1&limit=10"
      }
    },
    {
      "name": "Get Question",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/questions/{{questionId}}"
      }
    },
    {
      "name": "Update Question",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"difficulty\": \"INTERMEDIATE\",\n  \"defaultMarks\": 10\n}"
        },
        "url": "{{baseUrl}}/questions/{{questionId}}"
      }
    },
    {
      "name": "Duplicate Question",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/questions/{{questionId}}/duplicate"
      }
    },
    {
      "name": "Delete Question",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/questions/{{questionId}}"
      }
    },
    {
      "name": "Create Short Text Question",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/questions",
        "description": "Recruiter-only SHORT_TEXT question. No MCQ options or coding fields.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"SHORT_TEXT\",\n  \"contentHtml\": \"<p>Explain REST APIs briefly.</p>\",\n  \"difficulty\": \"BEGINNER\",\n  \"defaultMarks\": 5,\n  \"evaluationRubric\": \"Relevance and clarity.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Create Long Text Question",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/questions",
        "description": "Recruiter-only LONG_TEXT question.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"LONG_TEXT\",\n  \"contentHtml\": \"<p>Describe a scalable API architecture.</p>\",\n  \"difficulty\": \"INTERMEDIATE\",\n  \"defaultMarks\": 15,\n  \"evaluationRubric\": \"Design trade-offs, security, observability.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Create Coding Question",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/questions",
        "description": "Recruiter-only CODING question. Must include allowedLanguages, execution limits and at least one test case. Creating this question does not execute submitted code.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"CODING\",\n  \"contentHtml\": \"<p>Print the given input.</p>\",\n  \"difficulty\": \"BEGINNER\",\n  \"defaultMarks\": 10,\n  \"allowedLanguages\": [\n    \"javascript\"\n  ],\n  \"starterCode\": {\n    \"javascript\": \"const input = '';\\n\"\n  },\n  \"timeLimitMs\": 1000,\n  \"memoryLimitKb\": 65536,\n  \"testCases\": [\n    {\n      \"inputText\": \"hello\",\n      \"expectedOutput\": \"hello\",\n      \"isHidden\": false,\n      \"weight\": 1,\n      \"sortOrder\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ]
}
