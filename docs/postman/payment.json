{
	"info": {
		"_postman_id": "devment-clean-payment",
		"name": "Dev-ment - Payment APIs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{recruiterToken}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Get Pricing Plans",
			"request": {
				"method": "GET",
				"auth": {
					"type": "noauth"
				},
				"url": "{{baseUrl}}/payments/plans"
			}
		},
		{
			"name": "Create Checkout",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"planCode\": \"PRO\"\n}"
				},
				"url": "{{baseUrl}}/payments/checkout"
			}
		},
		{
			"name": "Get My Payments",
			"request": {
				"method": "GET",
				"url": "{{baseUrl}}/payments?page=1&limit=20"
			}
		},
		{
			"name": "Get Payment",
			"request": {
				"method": "GET",
				"url": "{{baseUrl}}/payments/{{paymentId}}"
			}
		},
		{
			"name": "Get Credits",
			"request": {
				"method": "GET",
				"url": "{{baseUrl}}/payments/credits"
			}
		},
		{
			"name": "Checkout Success",
			"request": {
				"method": "GET",
				"auth": {
					"type": "noauth"
				},
				"url": "{{baseUrl}}/payments/success?session_id={{stripeSessionId}}"
			}
		},
		{
			"name": "Checkout Cancel",
			"request": {
				"method": "GET",
				"auth": {
					"type": "noauth"
				},
				"url": "{{baseUrl}}/payments/cancel"
			}
		},
		{
			"name": "Stripe Webhook",
			"request": {
				"method": "POST",
				"auth": {
					"type": "noauth"
				},
				"description": "Stripe calls this endpoint with a valid Stripe-Signature and raw JSON body.",
				"url": "{{baseUrl}}/payments/webhook"
			}
		}
	]
}
