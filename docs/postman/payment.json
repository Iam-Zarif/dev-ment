{
  "info": {
    "_postman_id": "devment-clean-payment",
    "name": "Dev-ment - Payment APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pricing plans, recruiter payment history, credits and Stripe checkout. Payment status/credit grants are confirmed by a signed Stripe webhook; success redirect alone is not proof of payment."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{recruiterToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Get Pricing Plans",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/payments/plans"
      }
    },
    {
      "name": "Create Checkout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"planCode\": \"PRO\"\n}"
        },
        "url": "{{baseUrl}}/payments/checkout"
      }
    },
    {
      "name": "Get My Payments",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/payments?page=1&limit=20"
      }
    },
    {
      "name": "Get Payment",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/payments/{{paymentId}}"
      }
    },
    {
      "name": "Get Credits",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/payments/credits"
      }
    },
    {
      "name": "Checkout Success",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/payments/success?session_id={{stripeSessionId}}",
        "description": "Public Stripe redirect callback, typically redirects (303) to FRONTEND_URL/payment/success?session_id=... when frontend URL configured. Does NOT itself grant credits."
      }
    },
    {
      "name": "Checkout Cancel",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/payments/cancel",
        "description": "Public Stripe redirect callback; typically 303 to frontend /payment/cancel when FRONTEND_URL is configured."
      }
    },
    {
      "name": "Stripe Webhook",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "description": "For Stripe server-to-server delivery only. Requires authentic Stripe-Signature and raw application/json body. Do NOT manually send unsigned requests; payment/credits are finalized via webhook.",
        "url": "{{baseUrl}}/payments/webhook"
      }
    },
    {
      "name": "Get Checkout Payment Status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/payments/checkout-session/{{stripeSessionId}}",
        "description": "Recruiter-only lookup by Stripe Checkout session ID for the logged-in owner. Returns status, paidAt and creditGrant; confirmation requires status=PAID and creditGrant present.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{recruiterToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    }
  ]
}
