{
	"info": {
		"_postman_id": "devment-clean-auth",
		"name": "Dev-ment - Auth APIs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Register Candidate",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"legalName\": \"Demo Candidate\",\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\",\n  \"confirmPassword\": \"{{candidatePassword}}\"\n}"
				},
				"url": "{{baseUrl}}/auth/register/candidate"
			}
		},
		{
			"name": "Register Recruiter",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"legalName\": \"Demo Recruiter\",\n  \"email\": \"{{recruiterEmail}}\",\n  \"companyName\": \"Demo Company\",\n  \"jobTitle\": \"Technical Recruiter\",\n  \"password\": \"{{recruiterPassword}}\",\n  \"confirmPassword\": \"{{recruiterPassword}}\"\n}"
				},
				"url": "{{baseUrl}}/auth/register/recruiter"
			}
		},
		{
			"name": "Verify OTP",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"otp\": \"{{otp}}\",\n  \"purpose\": \"CANDIDATE_REGISTRATION\"\n}"
				},
				"url": "{{baseUrl}}/auth/verify-otp"
			}
		},
		{
			"name": "Resend OTP",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"purpose\": \"CANDIDATE_REGISTRATION\"\n}"
				},
				"url": "{{baseUrl}}/auth/resend-otp"
			}
		},
		{
			"name": "Login",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\"\n}"
				},
				"url": "{{baseUrl}}/auth/login"
			}
		},
		{
			"name": "Google Login",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"idToken\": \"{{googleIdToken}}\",\n  \"role\": \"CANDIDATE\"\n}"
				},
				"url": "{{baseUrl}}/auth/google"
			}
		},
		{
			"name": "Refresh Token",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
				},
				"url": "{{baseUrl}}/auth/refresh"
			}
		},
		{
			"name": "Logout",
			"request": {
				"method": "POST",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
				},
				"url": "{{baseUrl}}/auth/logout"
			}
		},
		{
			"name": "Forgot Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{candidateEmail}}\"\n}"
				},
				"url": "{{baseUrl}}/auth/forgot-password"
			}
		},
		{
			"name": "Reset Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
				},
				"url": "{{baseUrl}}/auth/reset-password"
			}
		},
		{
			"name": "Get Me",
			"request": {
				"method": "GET",
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"url": "{{baseUrl}}/auth/me"
			}
		}
	]
}
