      "item": [
        {
          "name": "Register Candidate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legalName\": \"{{candidateName}}\",\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\",\n  \"confirmPassword\": \"{{candidatePassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/candidate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register",
                "candidate"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Verify Candidate OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "if (json.success && json.data) {",
                  "  if (json.data.accessToken) {",
                  "    pm.environment.set(\"token\", json.data.accessToken);",
                  "  }",
                  "",
                  "  if (json.data.refreshToken) {",
                  "    pm.environment.set(\"refreshToken\", json.data.refreshToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"otp\": \"{{candidateOtp}}\",\n  \"purpose\": \"CANDIDATE_REGISTRATION\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
