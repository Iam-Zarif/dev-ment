{
  "info": {
    "_postman_id": "devment-clean-auth",
    "name": "Dev-ment - Auth APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Authentication and account recovery. Login issues an access token plus an HttpOnly refresh cookie. The refresh, session and reset-password flows use Postman's cookie jar; they do not accept a refresh token in JSON."
  },
  "item": [
    {
      "name": "Register Candidate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"legalName\": \"Demo Candidate\",\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\",\n  \"confirmPassword\": \"{{candidatePassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/register/candidate",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Register Recruiter",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"legalName\": \"Demo Recruiter\",\n  \"email\": \"{{recruiterEmail}}\",\n  \"companyName\": \"Demo Company\",\n  \"jobTitle\": \"Technical Recruiter\",\n  \"password\": \"{{recruiterPassword}}\",\n  \"confirmPassword\": \"{{recruiterPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/register/recruiter",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"otp\": \"{{otp}}\",\n  \"purpose\": \"CANDIDATE_REGISTRATION\"\n}"
        },
        "url": "{{baseUrl}}/auth/verify-otp",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Resend OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"purpose\": \"CANDIDATE_REGISTRATION\"\n}"
        },
        "url": "{{baseUrl}}/auth/resend-otp",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "description": "Candidate login. Save the response data.accessToken as candidateToken in active Postman variables, and let Postman retain the devment_refresh_token cookie."
      }
    },
    {
      "name": "Google Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idToken\": \"{{googleIdToken}}\",\n  \"role\": \"CANDIDATE\"\n}"
        },
        "url": "{{baseUrl}}/auth/google",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/auth/refresh",
        "auth": {
          "type": "noauth"
        },
        "description": "Requires devment_refresh_token HttpOnly cookie from Login/OTP verification (same Postman host). Bodyless request; refresh rotates the session and sets a new cookie."
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/auth/logout",
        "description": "Requires Bearer access token AND devment_refresh_token cookie from the same session. Both are required; request has no body."
      }
    },
    {
      "name": "Forgot Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{candidateEmail}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/forgot-password",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Verify Password Reset OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"otp\": \"123456\"\n}"
        },
        "url": "{{baseUrl}}/auth/verify-password-reset-otp",
        "description": "Use the OTP from the reset email. A successful response sets an HttpOnly reset-session cookie used by Reset Password.",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
        },
        "url": "{{baseUrl}}/auth/reset-password",
        "auth": {
          "type": "noauth"
        },
        "description": "Requires the HttpOnly password-reset cookie issued by Verify Password Reset OTP. Do not send a reset token in the JSON body."
      }
    },
    {
      "name": "Get Me",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/auth/me",
        "description": "Requires Bearer accessToken."
      }
    },
    {
      "name": "Verify Current Session",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/session",
        "description": "Verifies devment_refresh_token HttpOnly cookie and Redis session non-destructively; returns {userId, role}. No Bearer token or request body.",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "Login Recruiter",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "description": "Recruiter login. Save response data.accessToken as recruiterToken; refresh cookie is stored in the Postman cookie jar.",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{recruiterEmail}}\",\n  \"password\": \"{{recruiterPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Login Admin",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "description": "Admin login. Save response data.accessToken as adminToken. Use an existing administrator account.",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ]
}
