{
  "info": {
    "_postman_id": "devment-clean-application",
    "name": "Dev-ment - Application APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001/api/v1" },
    { "key": "candidateToken", "value": "" },
    { "key": "recruiterToken", "value": "" },
    { "key": "assessmentId", "value": "" },
    { "key": "applicationId", "value": "" }
  ],
  "item": [
    {
      "name": "Apply to Assessment",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{candidateToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assessmentId\": \"{{assessmentId}}\",\n  \"coverNote\": \"I am interested in this assessment.\"\n}"
        },
        "url": "{{baseUrl}}/applications"
      }
    },
    {
      "name": "Get My Applications",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{candidateToken}}", "type": "string" }]
        },
        "url": "{{baseUrl}}/applications/me?page=1&limit=20"
      }
    },
    {
      "name": "Get My Application",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{candidateToken}}", "type": "string" }]
        },
        "url": "{{baseUrl}}/applications/me/{{applicationId}}"
      }
    },
    {
      "name": "Get Recruiter Applications",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{recruiterToken}}", "type": "string" }]
        },
        "url": "{{baseUrl}}/applications/recruiter?assessmentId={{assessmentId}}&page=1&limit=20"
      }
    },
    {
      "name": "Get Recruiter Application",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{recruiterToken}}", "type": "string" }]
        },
        "url": "{{baseUrl}}/applications/recruiter/{{applicationId}}"
      }
    },
    {
      "name": "Shortlist Application",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{recruiterToken}}", "type": "string" }]
        },
        "url": "{{baseUrl}}/applications/{{applicationId}}/shortlist"
      }
    },
    {
      "name": "Reject Application",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{recruiterToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rejectionReason\": \"Not selected for this role.\"\n}"
        },
        "url": "{{baseUrl}}/applications/{{applicationId}}/reject"
      }
    }
  ]
}