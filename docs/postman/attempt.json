{
  "info": {
    "_postman_id": "15a80a85-3873-4965-93f9-devment-attempt-final",
    "name": "Dev-ment - Attempt APIs",
    "description": "Candidate assessment attempt, safe question delivery, autosave, proctor events and submission.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api/v1"
    },
    {
      "key": "candidateToken",
      "value": ""
    },
    {
      "key": "invitationId",
      "value": ""
    },
    {
      "key": "attemptId",
      "value": ""
    },
    {
      "key": "mcqAssessmentQuestionId",
      "value": ""
    },
    {
      "key": "mcqOptionId",
      "value": ""
    },
    {
      "key": "textAssessmentQuestionId",
      "value": ""
    },
    {
      "key": "codingAssessmentQuestionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Start Attempt",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"invitationId\": \"{{invitationId}}\"\n}"
        },
        "url": "{{baseUrl}}/attempts/start"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test(\"Attempt started\", function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.attempt.status).to.eql(\"IN_PROGRESS\");",
              "  pm.expect(json.data.attempt.id).to.be.a(\"string\");",
              "  pm.expect(json.data.attempt.expiresAt).to.exist;",
              "  pm.expect(json.data.attempt.serverNow).to.exist;",
              "  pm.expect(json.data.questions).to.be.an(\"array\");",
              "});",
              "",
              "pm.collectionVariables.set(\"attemptId\", json.data.attempt.id);",
              "",
              "const questions = json.data.questions || [];",
              "",
              "const mcq = questions.find((q) => q.type === \"MCQ\");",
              "if (mcq) {",
              "  pm.collectionVariables.set(\"mcqAssessmentQuestionId\", mcq.assessmentQuestionId);",
              "  if (mcq.options?.[0]?.id) {",
              "    pm.collectionVariables.set(\"mcqOptionId\", mcq.options[0].id);",
              "  }",
              "}",
              "",
              "const text = questions.find((q) => q.type === \"SHORT_TEXT\" || q.type === \"LONG_TEXT\");",
              "if (text) {",
              "  pm.collectionVariables.set(\"textAssessmentQuestionId\", text.assessmentQuestionId);",
              "}",
              "",
              "const coding = questions.find((q) => q.type === \"CODING\");",
              "if (coding) {",
              "  pm.collectionVariables.set(\"codingAssessmentQuestionId\", coding.assessmentQuestionId);",
              "}",
              "",
              "pm.test(\"MCQ correct answers are not leaked\", function () {",
              "  questions.filter((q) => q.type === \"MCQ\").forEach((q) => {",
              "    (q.options || []).forEach((option) => {",
              "      pm.expect(option).to.not.have.property(\"isCorrect\");",
              "    });",
              "  });",
              "});",
              "",
              "pm.test(\"Coding test cases are not leaked\", function () {",
              "  questions.filter((q) => q.type === \"CODING\").forEach((q) => {",
              "    pm.expect(q).to.not.have.property(\"codingTestCases\");",
              "    pm.expect(q).to.not.have.property(\"testCases\");",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Resume Attempt",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/attempts/{{attemptId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test(\"Timer is server authoritative\", function () {",
              "  pm.expect(json.data.attempt.serverNow).to.exist;",
              "  pm.expect(json.data.attempt.expiresAt).to.exist;",
              "  pm.expect(json.data.attempt.remainingSeconds).to.be.a(\"number\");",
              "});"
            ]
          }
        }
      ]
    },
