{
  "info": {
    "_postman_id": "4f4e4ad7-devment-admin-final",
    "name": "Dev-ment - Admin APIs",
    "description": "Admin dashboard, users, companies, pricing plans, recruiter credits, payments and audit logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api/v1"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "candidateToken",
      "value": ""
    },
    {
      "key": "recruiterToken",
      "value": ""
    },
    {
      "key": "targetUserId",
      "value": ""
    },
    {
      "key": "deleteUserId",
      "value": ""
    },
    {
      "key": "companyId",
      "value": ""
    },
    {
      "key": "recruiterProfileId",
      "value": ""
    },
    {
      "key": "planId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Dashboard",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/dashboard"
      }
    },
    {
      "name": "02 - List Users",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/users?page=1&limit=50"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "const candidate = json.data.items.find((item) => item.role === \"CANDIDATE\" && item.status !== \"DELETED\");",
              "if (candidate) pm.collectionVariables.set(\"targetUserId\", candidate.id);",
              "const recruiter = json.data.items.find((item) => item.role === \"RECRUITER\" && item.recruiterProfile);",
              "if (recruiter) {",
              "  pm.collectionVariables.set(\"recruiterProfileId\", recruiter.recruiterProfile.id);",
              "  if (recruiter.recruiterProfile.company) pm.collectionVariables.set(\"companyId\", recruiter.recruiterProfile.company.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Get User Details",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/users/{{targetUserId}}"
      }
    },
    {
      "name": "04 - Block User",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"BLOCKED\"\n}"
        },
        "url": "{{baseUrl}}/admin/users/{{targetUserId}}/status"
      }
    },
    {
      "name": "05 - Activate User",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/admin/users/{{targetUserId}}/status"
      }
    },
    {
      "name": "06 - List Companies",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/companies?page=1&limit=50"
      }
    },
    {
      "name": "07 - Unverify Company",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isVerified\": false\n}"
        },
        "url": "{{baseUrl}}/admin/companies/{{companyId}}/verification"
      }
    },
    {
      "name": "08 - Verify Company",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isVerified\": true\n}"
        },
        "url": "{{baseUrl}}/admin/companies/{{companyId}}/verification"
      }
    },
    {
      "name": "09 - List Pricing Plans",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/pricing-plans"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "const pro = json.data.find((plan) => plan.code === \"PRO\");",
              "if (pro) pm.collectionVariables.set(\"planId\", pro.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Update PRO Plan",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Pro\"\n}"
        },
        "url": "{{baseUrl}}/admin/pricing-plans/{{planId}}"
      }
    },
    {
      "name": "11 - Get Recruiter Credits",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/recruiters/{{recruiterProfileId}}/credits"
      }
    },
    {
      "name": "12 - Grant Recruiter Admin Credit",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"credits\": 1,\n  \"validityDays\": 30,\n  \"reason\": \"Postman admin verification\"\n}"
        },
        "url": "{{baseUrl}}/admin/recruiters/{{recruiterProfileId}}/credits"
      }
    },
    {
      "name": "13 - List Payments",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/payments?page=1&limit=50"
      }
    },
    {
      "name": "14 - Audit Logs",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/audit-logs?page=1&limit=50"
      }
    },
    {
      "name": "Negative Tests",
      "item": [
        {
          "name": "Candidate Cannot Access Admin",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{candidateToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/admin/dashboard"
          }
        },
        {
          "name": "Recruiter Cannot Access Admin",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "Invalid User UUID",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/admin/users/not-a-uuid"
          }
        }
      ]
    },
    {
      "name": "Optional Dangerous Operations",
      "item": [
        {
          "name": "Soft Delete User",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/admin/users/{{deleteUserId}}"
          }
        }
      ]
    }
  ]
}